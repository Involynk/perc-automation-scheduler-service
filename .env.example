# ==============================================================================
# PERC Scheduler Engine — Environment Variable Reference
# Copy to .env and fill in actual values. Never commit .env to version control.
# ==============================================================================

PORT=3000
NODE_ENV=production   # development | production | test

# -----------------------------------------------------------------------
# Database (Supabase PostgreSQL)
#
# IMPORTANT — IPv6 / Docker networking note:
# The Supabase direct connection (db.<ref>.supabase.co) resolves to IPv6 only.
# Docker Desktop containers are IPv4-only. Use the Supabase Pooler (Supavisor)
# connection string for containerized deployments.
#
# Direct connection (IPv4-capable environments only):
#   DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public&sslmode=require"
#
# Supabase Pooler — Session Mode port 5432 (recommended for Prisma + containers):
#   DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require"
#
# Supabase Pooler — Transaction Mode port 6543 (add pgbouncer=true):
#   DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public&sslmode=require"
#
# If the password contains special characters, URL-encode them. Example: @ → %40
# -----------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public&sslmode=require"

# -----------------------------------------------------------------------
# Redis (BullMQ)
# Docker Compose: REDIS_HOST=redis  (service name)
# Local dev:      REDIS_HOST=localhost
# -----------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------
# Kafka
# Docker Compose: KAFKA_BROKERS=kafka:29092  (internal listener)
# Local dev:      KAFKA_BROKERS=localhost:9092
# Multiple brokers: KAFKA_BROKERS=broker1:9092,broker2:9092
# -----------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=perc-scheduler-service
KAFKA_GROUP_ID=perc-scheduler-group
KAFKA_USE_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# -----------------------------------------------------------------------
# Outbox Publisher
# -----------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5

# -----------------------------------------------------------------------
# BullMQ Worker
# -----------------------------------------------------------------------
BULLMQ_CONCURRENCY=20
BULLMQ_LOCK_DURATION_MS=30000
