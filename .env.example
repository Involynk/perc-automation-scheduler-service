DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public&sslmode=require"
KAFKA_BROKERS=localhost:9092
KAFKA_USE_SSL=false
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

PORT=3003
NODE_ENV=production

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5

DEFAULT_FOLLOWUP_DELAY_MS=7200000
MEETING_REMINDER_LEAD_TIME_MS=3600000
POST_MEETING_FEEDBACK_DELAY_MS=1800000

KAFKA_CLIENT_ID=perc-scheduler-service
KAFKA_GROUP_ID=perc-scheduler-group
KAFKA_TOPIC_RESPONSE_SENT=perc.response.sent
KAFKA_TOPIC_MEETING_EVENTS=perc.meeting-events
KAFKA_TOPIC_TIMER_TRIGGERED=perc.scheduler.timer-triggered
